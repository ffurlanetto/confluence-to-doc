# Copy to .env and adjust. Every variable is documented in docs/configuration.md.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://c2d:c2d@localhost:5432/c2d?sslmode=disable
# OAuth2 / OpenID Connect provider (Keycloak, Entra ID, Okta, Google, ...).
# Values below match the development mock (make dev-mocks).
OIDC_ISSUER_URL=http://localhost:8091
OIDC_CLIENT_ID=confluence-to-doc
OIDC_CLIENT_SECRET=dev-secret
# Members of these groups (comma-separated) get the administration pages. The
# development mock puts its user in c2d-admins.
OIDC_ADMIN_GROUPS=c2d-admins
# The single Confluence instance users connect to with their PAT.
CONFLUENCE_BASE_URL=http://localhost:8090
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing or changing it makes stored PATs unreadable (users re-enter them).
# To rotate it, use ENCRYPTION_KEYS=new-id:<new key>, default:<this key> instead.
ENCRYPTION_KEY=

# --- Optional (defaults shown) ------------------------------------------------
# With the Vite dev server use http://localhost:5173 so the OAuth2 callback
# goes through the Vite proxy and cookies stay on the same origin.
PUBLIC_URL=http://localhost:8080
# APP_ROLE=all                       # all | api | worker
# HTTP_ADDR=:8080
# LOG_LEVEL=info
LOG_FORMAT=text
# SESSION_TTL=12h
# CONFLUENCE_RATE_LIMIT=10            # requests/s to Confluence, all instances together (0 = unlimited)
# CONFLUENCE_RATE_BURST=20
# API_RATE_LIMIT=300                  # API requests/min per user (0 = unlimited)
# API_RATE_BURST=60
# AUTH_RATE_LIMIT=30                  # sign-in requests/min per client address
# SESSION_REVALIDATE_INTERVAL=15m     # re-check sessions with the IdP (Entra ID: add offline_access to OIDC_SCOPES)
# ACCOUNT_RETENTION=4320h             # delete accounts unused for 180 days (0 = never)
# ACCOUNT_DELETION_NOTICE=360h        # warning 15 days before
# DOCUMENT_LANGUAGE=                  # e.g. fr-FR: language declared in the tagged PDF
# OIDC_GROUPS_CLAIM=groups            # claim holding groups/roles; dotted path for nested claims
# AUDIT_RETENTION=8760h               # audit events kept one year (minimum 720h)
# TRUSTED_PROXIES=                    # CIDRs allowed to set X-Forwarded-For, e.g. 10.0.0.0/8
# EXPORT_RETENTION=48h
# EXPORT_WORKER_CONCURRENCY=2
# EXPORT_MAX_ACTIVE_PER_USER=5
# EXPORT_MAX_PAGES=500
# EXPORT_JOB_TIMEOUT=15m
# EXPORT_MAX_ATTEMPTS=3
# EXPORT_STORAGE_DIR=./data/exports
# DOCUMENT_CLASSIFICATION=           # default classification when the user picks none
# DOCUMENT_CLASSIFICATIONS=Public, Internal, Confidential:watermark, Restricted:watermark

# --- S3 storage (feature flag) --------------------------------------------------
# Setting S3_BUCKET switches document storage from local disk to S3 / S3-compatible.
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=                        # e.g. https://minio.example.com (empty = AWS)
# S3_ACCESS_KEY_ID=                   # empty = AWS default credential chain (IAM role...)
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=exports/
# S3_FORCE_PATH_STYLE=                # defaults to true when S3_ENDPOINT is set
# SOFFICE_PATH=soffice

# --- OpenTelemetry --------------------------------------------------------------
# Traces and metrics are exported over OTLP as soon as an endpoint is set; empty
# disables telemetry entirely. Standard OTEL_EXPORTER_OTLP_* variables (headers,
# TLS, compression, timeouts) are read directly by the exporters.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc      # grpc | http/protobuf
# OTEL_SERVICE_NAME=confluence-to-doc
# OTEL_TRACES_SAMPLER_ARG=1             # head sampling ratio, 0..1
# OTEL_METRIC_EXPORT_INTERVAL=1m
# Identity carried by every metric and span. This is how you tag the owning
# application and team; it needs no code and renames nothing.
# OTEL_RESOURCE_ATTRIBUTES=service.namespace=docs-platform,team=platform,deployment.environment=prod
# Prefix for this application's own metrics only (semantic-convention metrics
# keep their standard names). Not an OTEL_* variable: the spec defines none.
# TELEMETRY_METRIC_PREFIX=

# --- Company Word template ------------------------------------------------------
# A .docx/.dotx template whose header, footer, fonts and page layout are applied to
# every generated document (Word and PDF). Empty = built-in styling.
# See docs/word-template.md for how to prepare it.
# WORD_TEMPLATE_PATH=

# --- Document properties --------------------------------------------------------
# Written to the subject of every generated document (Word and PDF), for the
# document management systems that sort on it. Empty leaves the subject unset.
# The other properties — title, author, description, keywords, source page —
# come from the export itself and need no configuration.
# DOCUMENT_CLASSIFICATION=Internal
